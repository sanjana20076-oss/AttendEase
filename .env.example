# Copy to .env in the project root. Never commit the real .env.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Kolkata
DATABASE_PATH=database/attendance.db
FACE_MATCH_THRESHOLD=0.50
FACE_MATCH_MARGIN=0.05
# Set to 1 only when serving the application via HTTPS (not local HTTP).
SESSION_COOKIE_SECURE=0
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
# Optional: pre-provision the InsightFace buffalo_l model under this directory.
# FACE_MODEL_ROOT=/path/to/insightface

# New student matches: Present + explicitly automatic successful review.
# Set to 0 to retain the previous Present/Pending workflow.
AUTO_APPROVE_ATTENDANCE=1
# Webcam step-up access for faculty records; enforced range is 30–900 seconds.
FACULTY_RECORDS_VERIFICATION_TTL=300
